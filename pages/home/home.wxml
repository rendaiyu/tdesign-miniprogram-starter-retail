<view class="jy-page home">
  <view class="hero" style="padding-top:{{statusBarHeight}}px">
    <image class="campus-background" src="/assets/home/campus.jpg" mode="aspectFill" /><view class="hero-wash"></view>
    <view class="brand-row"
      ><image class="brand-mark" src="/assets/home/vase.svg" /><text class="brand-title">景院集市</text></view
    >
    <view class="brand-subtitle">景德镇学院 · 校园交易平台</view>
    <view class="search-box"
      ><t-icon name="search" size="36rpx" /><input
        class="search-input"
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
        placeholder="搜索二手商品、教材、画具……"
        placeholder-class="search-placeholder"
        maxlength="50"
        aria-label="搜索示例商品"
      /><button wx:if="{{keyword}}" class="clear-search" bindtap="clearSearch" aria-label="清空搜索"
        ><t-icon name="close" size="30rpx" /></button
      ><button wx:else class="search-action" bindtap="onSearchConfirm">搜索</button></view
    >
  </view>
  <view class="main-content">
    <view class="quick-entries"
      ><button
        wx:for="{{entries}}"
        wx:key="key"
        class="quick-entry"
        data-key="{{item.key}}"
        bindtap="onEntry"
        hover-class="jy-pressed"
        ><view class="entry-icon {{item.tone}}"><t-icon name="{{item.icon}}" size="45rpx" /></view
        ><text class="entry-name">{{item.name}}</text><text class="entry-subtitle">{{item.subtitle}}</text></button
      ></view
    >
    <button class="activity" bindtap="onActivity" hover-class="jy-pressed"
      ><view class="activity-copy"
        ><text class="activity-title">毕业季 · 闲置不闲</text
        ><text class="activity-subtitle">让好物遇见下一个景院人</text></view
      ><image class="activity-plane" src="/assets/home/paper-plane.svg" /><t-icon name="chevron-right" size="30rpx"
    /></button>
    <view id="campus-market" class="market">
      <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}"
        ><view class="category-row"
          ><button
            wx:for="{{categories}}"
            wx:key="key"
            class="category {{category===item.key?'selected':''}}"
            data-key="{{item.key}}"
            bindtap="onCategoryChange"
            hover-class="jy-pressed"
            >{{item.label}}</button
          ></view
        ></scroll-view
      >
      <view class="market-note"><text>同校好物，等你发现</text><text class="demo-label">商品与卖家均为示例</text></view>
      <view wx:if="{{loading}}" class="state"><t-loading theme="circular" size="40rpx" text="好物加载中" /></view>
      <view wx:elif="{{failed}}" class="state"
        ><t-icon name="error-circle" size="60rpx" /><text class="state-title">暂时没能加载好物</text
        ><button class="state-action" bindtap="loadHome">重新加载</button></view
      >
      <view wx:elif="{{!totalCount}}" class="state"
        ><t-icon name="search" size="60rpx" /><text class="state-title">还没有找到这件好物</text
        ><text class="state-description">试试其他关键词，或看看全部示例商品</text
        ><button class="state-action" bindtap="resetFilters">查看全部</button></view
      >
      <view wx:else class="waterfall"
        ><view
          wx:for="{{columns}}"
          wx:for-item="column"
          wx:for-index="columnIndex"
          wx:key="index"
          class="waterfall-column"
          ><campus-goods-card
            wx:for="{{column}}"
            wx:for-item="goods"
            wx:key="id"
            goods="{{goods}}"
            bind:open="onGoodsOpen"
            bind:favorite="onFavorite" /></view
      ></view>
      <view wx:if="{{!loading && !failed && totalCount}}" class="list-end"
        >{{visibleCount < totalCount?'继续上滑，发现更多好物':'好物不浪费，美好在景院'}}</view
      >
    </view>
  </view>
</view>
