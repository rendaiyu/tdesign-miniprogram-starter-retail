page {
  background: var(--jy-background);
  padding-bottom: calc(126rpx + env(safe-area-inset-bottom));
}
.home {
  min-height: 100vh;
}
.home button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  font-family: inherit;
  line-height: 1.5;
  background: transparent;
}
.home button::after {
  border: 0;
}
.hero {
  position: relative;
  overflow: hidden;
  background: var(--jy-sky);
  padding-bottom: 26rpx;
}
.campus-background {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.68;
}
.hero-wash {
  position: absolute;
  inset: 0;
  background: rgba(247, 249, 248, 0.22);
}
.brand-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 44px;
  padding: 0 32rpx;
}
.brand-mark {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}
.brand-title {
  font-size: 40rpx;
  letter-spacing: 2rpx;
  font-weight: 750;
  color: var(--jy-text);
}
.brand-subtitle {
  position: relative;
  padding: 8rpx 32rpx 24rpx;
  font-size: 23rpx;
  color: var(--jy-text);
  font-weight: 500;
}
.search-box {
  position: relative;
  margin: 0 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 82rpx;
  padding: 0 14rpx 0 24rpx;
  background: var(--jy-surface);
  border-radius: 44rpx;
  box-shadow: var(--jy-shadow);
  color: var(--jy-readable-secondary);
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 82rpx;
  font-size: 25rpx;
  color: var(--jy-text);
}
.search-placeholder {
  color: var(--jy-readable-secondary);
}
.home .search-action {
  background: var(--jy-tint);
  color: var(--jy-primary-dark);
  padding: 12rpx 22rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}
.clear-search {
  width: 64rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.main-content {
  padding: 0 24rpx;
}
.quick-entries {
  display: flex;
  justify-content: space-between;
  padding: 26rpx 0 24rpx;
}
.home .quick-entry {
  display: flex;
  align-items: center;
  flex-direction: column;
  width: 25%;
  overflow: visible;
}
.entry-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--jy-primary-dark);
  background: var(--jy-tint);
  margin-bottom: 12rpx;
}
.entry-icon.blue {
  background: var(--jy-blue-tint);
  color: var(--jy-blue);
}
.entry-icon.sand {
  background: var(--jy-clay);
  color: var(--jy-sand);
}
.entry-name {
  font-size: 26rpx;
  font-weight: 600;
}
.entry-subtitle {
  font-size: 21rpx;
  color: var(--jy-readable-secondary);
  margin-top: 4rpx;
}
.home .activity {
  width: 100%;
  border-radius: var(--jy-radius);
  background: var(--jy-tint);
  min-height: 148rpx;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  text-align: left;
  overflow: hidden;
  color: var(--jy-primary-dark);
}
.activity-copy {
  flex: 1;
  min-width: 0;
}
.activity-title {
  display: block;
  font-size: 36rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
}
.activity-subtitle {
  display: block;
  font-size: 24rpx;
  margin-top: 8rpx;
}
.activity-plane {
  width: 118rpx;
  height: 100rpx;
  flex-shrink: 0;
  margin: 0 8rpx;
}
.category-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 14rpx;
}
.category-row {
  display: flex;
  align-items: center;
  width: max-content;
  min-width: 100%;
  gap: 32rpx;
}
.home .category {
  position: relative;
  font-size: 26rpx;
  color: var(--jy-readable-secondary);
  padding: 24rpx 0;
  flex-shrink: 0;
  overflow: visible;
}
.home .category.selected {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--jy-text);
}
.category.selected::before {
  content: '';
  position: absolute;
  bottom: 12rpx;
  left: calc(50% - 16rpx);
  width: 32rpx;
  height: 6rpx;
  background: var(--jy-primary);
  border-radius: 6rpx;
}
.market-note {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--jy-readable-secondary);
  margin: 4rpx 0 20rpx;
}
.demo-label {
  font-size: 20rpx;
}
.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.waterfall-column {
  width: calc((100% - 20rpx) / 2);
  min-width: 0;
}
.state {
  padding: 60rpx 16rpx;
  text-align: center;
  color: var(--jy-readable-secondary);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}
.state-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--jy-text);
}
.state-description {
  font-size: 24rpx;
}
.home .state-action {
  padding: 16rpx 32rpx;
  background: var(--jy-tint);
  color: var(--jy-primary-dark);
  border-radius: 36rpx;
  font-size: 26rpx;
}
.list-end {
  text-align: center;
  font-size: 23rpx;
  color: var(--jy-readable-secondary);
  padding: 18rpx 0 32rpx;
}
