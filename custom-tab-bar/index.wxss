.campus-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
  padding: 12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));
  background: var(--jy-surface, #fff);
  border-top: 1rpx solid var(--jy-line, #edf1ee);
  box-sizing: border-box;
}
.nav-item {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: none;
  margin: 0;
  padding: 0;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--jy-readable-secondary, #66736d);
  overflow: visible;
  border-radius: 0;
}
.nav-item::after {
  border: 0;
}
.nav-icon {
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.active {
  color: var(--jy-primary-dark, #167d65);
  font-weight: 600;
}
.publish-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border: 8rpx solid var(--jy-surface, #fff);
  box-sizing: border-box;
  border-radius: 50%;
  background: var(--jy-primary, #25a77f);
  color: var(--jy-surface, #fff);
  margin-top: -34rpx;
}
.nav-pressed {
  opacity: 0.7;
}
