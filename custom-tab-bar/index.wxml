<view class="campus-nav"
  ><button
    wx:for="{{list}}"
    wx:key="url"
    class="nav-item {{active===index?'active':''}}"
    data-index="{{index}}"
    bindtap="onChange"
    hover-class="nav-pressed"
    aria-label="{{item.text}}"
    ><view class="{{item.publish?'publish-circle':'nav-icon'}}"
      ><t-icon name="{{item.icon}}" size="{{item.publish?'48rpx':'42rpx'}}" /></view
    ><text class="nav-label">{{item.text}}</text></button
  ></view
>
